amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// The only steps `mise run lint:hk` runs; `lint:py` covers the Python tools.
local hygiene = new Mapping<String, Step> {
  // File hygiene
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    exclude = List("poetry.lock")
  }
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["end-of-file-fixer"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace

  // Django templates: lint and format check in one djlint run
  ["djlint"] {
    glob = List("src/**/*.html")
    check = "djlint {{files}} --lint --check --profile=django"
    fix = "djlint {{files}} --lint --reformat --profile=django"
  }
}

// `mise run lint:py` checks these on every gate. The commit and fix hooks add
// them so staged files still get formatted.
local formatters = new Mapping<String, Step> {
  ["black"] = Builtins.black
  ["ruff"] = Builtins.ruff
  ["codespell"] {
    glob = List("**/*")
    exclude = List("**/*.lock")
    check = "codespell --toml=pyproject.toml {{files}}"
  }
  ["taplo"] {
    glob = List("*.toml")
    check = "taplo format --check --config=.taplo.toml {{files}}"
    fix = "taplo format --config=.taplo.toml {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...hygiene
      ...formatters
    }
  }
  // The type check reads the whole project, so it takes no file list; hk runs
  // it once, and only when the push touches Python source.
  ["pre-push"] {
    steps {
      ...hygiene
      ...formatters
      ["mypy"] {
        glob = List("src/**/*.py")
        check = "mise run lint:mypy"
      }
    }
  }
  ["fix"] {
    fix = true
    steps {
      ...hygiene
      ...formatters
    }
  }
  ["check"] {
    steps = hygiene
  }
}
